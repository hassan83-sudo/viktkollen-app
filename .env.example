# Supabase client auth, cloud backup and sync.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional server-side Supabase helpers for verification/API flows.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only OpenAI key. Do not prefix with VITE_.
# Required only when remote AI/photo provider should be enabled in production.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_COACH_MODEL=gpt-4.1-mini
OPENAI_COACH_TIMEOUT_MS=15000
OPENAI_COACH_RATE_LIMIT_MAX=8
OPENAI_MAX_OUTPUT_TOKENS=900
NUTRITION_PHOTO_MODEL=gpt-4.1-mini
NUTRITION_PHOTO_MAX_FILE_BYTES=8388608
NUTRITION_PHOTO_TIMEOUT_MS=15000
NUTRITION_PHOTO_RATE_LIMIT_WINDOW_MS=600000
NUTRITION_PHOTO_RATE_LIMIT_MAX=12

# Keep false unless OPENAI_API_KEY is configured and route verification passes.
VITE_NUTRITION_PHOTO_REMOTE_ENABLED=false
VITE_NUTRITION_PHOTO_MAX_FILE_MB=8
VITE_NUTRITION_PHOTO_TIMEOUT_MS=15000
VITE_NUTRITION_PHOTO_RATE_LIMIT_MAX=12
