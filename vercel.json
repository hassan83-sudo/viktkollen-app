{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self), display-capture=(), interest-cohort=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "functions": {
    "api/ai-ear/interpret/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/billing/quota",
      "destination": "/api/billing/user?__vk_route=quota"
    },
    {
      "source": "/api/billing/quota/",
      "destination": "/api/billing/user?__vk_route=quota"
    },
    {
      "source": "/api/billing/subscription",
      "destination": "/api/billing/user?__vk_route=subscription"
    },
    {
      "source": "/api/billing/subscription/",
      "destination": "/api/billing/user?__vk_route=subscription"
    },
    {
      "source": "/api/entitlements",
      "destination": "/api/billing/user?__vk_route=entitlements"
    },
    {
      "source": "/api/entitlements/",
      "destination": "/api/billing/user?__vk_route=entitlements"
    },
    {
      "source": "/api/billing/plans",
      "destination": "/api/billing/user?__vk_route=plans"
    },
    {
      "source": "/api/billing/plans/",
      "destination": "/api/billing/user?__vk_route=plans"
    },
    {
      "source": "/api/billing/capability",
      "destination": "/api/billing/user?__vk_route=capability"
    },
    {
      "source": "/api/billing/capability/",
      "destination": "/api/billing/user?__vk_route=capability"
    },
    {
      "source": "/api/billing/usage",
      "destination": "/api/billing/user?__vk_route=usage"
    },
    {
      "source": "/api/billing/usage/",
      "destination": "/api/billing/user?__vk_route=usage"
    }
  ]
}
